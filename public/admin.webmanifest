{
  "id": "/admin",
  "name": "Minerva Admin",
  "short_name": "Minerva Admin",
  "description": "Panel de administración de Minerva: productos, categorías y pedidos.",
  "lang": "es-CL",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf8f4",
  "theme_color": "#fbf8f4",
  "icons": [
    { "src": "/admin-app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin-app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin-app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pedidos", "url": "/admin/pedidos", "icons": [{ "src": "/admin-app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Productos", "url": "/admin/productos", "icons": [{ "src": "/admin-app/icon-192.png", "sizes": "192x192" }] }
  ]
}
