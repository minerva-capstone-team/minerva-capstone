# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
# Solo la URL y la anon key van en el frontend. NUNCA pongas aquí la service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pasarelas de pago (activar cuando estén configuradas)
NEXT_PUBLIC_PAYMENTS_WEBPAY=false
NEXT_PUBLIC_PAYMENTS_MERCADOPAGO=false

# Emails de pedido (Resend) — https://resend.com/api-keys. Solo servidor: SIN prefijo NEXT_PUBLIC_.
RESEND_API_KEY=
# Remitente. Con onboarding@resend.dev (sin dominio propio) NO se envía la confirmación al cliente, solo el aviso a
# ORDER_NOTIFY_EMAIL, que debe ser el correo de tu cuenta de Resend. Con un dominio verificado se envían ambos.
RESEND_FROM=Minerva <onboarding@resend.dev>
# Correo de la tienda que recibe aviso de cada pedido nuevo
ORDER_NOTIFY_EMAIL=
# Notificaciones push a la app del admin (pedido nuevo). Genera el par de claves UNA vez con:
#   npx web-push generate-vapid-keys
# La pública va en el navegador (NEXT_PUBLIC_); la privada SOLO en el servidor. VAPID_SUBJECT: "mailto:tu@correo.cl".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Chatbot de ayuda (Google Gemini) — https://aistudio.google.com/apikey. Solo servidor: SIN prefijo NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional: fija un modelo concreto (por defecto gemini-flash-latest)
GEMINI_MODEL=
# Bot de Instagram (mensajes directos) — ver la sección "Bot de Instagram" del README. Solo servidor.
# App Secret: developers.facebook.com > tu app > Configuración > Básica
INSTAGRAM_APP_SECRET=
# Una frase larga inventada por ti; la misma que pegas al configurar el webhook en Meta
INSTAGRAM_VERIFY_TOKEN=
# Token de acceso de Instagram generado en el panel de la app (dura ~60 días: hay que renovarlo)
INSTAGRAM_ACCESS_TOKEN=